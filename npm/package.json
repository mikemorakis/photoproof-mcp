{
  "name": "photoproof",
  "version": "0.1.0",
  "description": "Official photoproof.io CLI and typed client: set up the photoproof MCP server in Claude Desktop, Cursor, VS Code or Claude Code, and query the public photoproof API.",
  "keywords": ["photoproof", "photoproof.io", "mcp", "mcp-server", "model-context-protocol", "claude", "cursor", "photo-proofing", "photographers", "cli", "api-client"],
  "homepage": "https://photoproof.io/developers",
  "bugs": { "url": "https://github.com/mikemorakis/photoproof-mcp/issues", "email": "support@photoproof.io" },
  "repository": { "type": "git", "url": "git+https://github.com/mikemorakis/photoproof-mcp.git", "directory": "npm" },
  "license": "MIT",
  "author": "photoproof.io (https://photoproof.io)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./config": { "types": "./dist/config.d.ts", "default": "./dist/config.js" },
    "./package.json": "./package.json"
  },
  "bin": { "photoproof": "dist/cli.js", "photoproof-mcp": "dist/cli.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "test": "node --test test/",
    "prepack": "npm run build"
  },
  "devDependencies": { "typescript": "^5.6.0", "@types/node": "^20.0.0" }
}
